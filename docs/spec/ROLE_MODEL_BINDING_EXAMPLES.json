  "offboarding_lifecycle_example": {
    "scenario": "角色离册 → 新任务 → 回册（F3）",
    "steps": [
      {
        "step": 1,
        "action": "同步前：agent:kimi-code-k28-preview 在册且有完整绑定 v1",
        "get_binding_state": "bound",
        "row_exists": true
      },
      {
        "step": 2,
        "action": "POST /api/projects/{id}/sync 全量替换，名册不再包含该成员",
        "get_binding_state": "not_in_roster",
        "row_exists": true,
        "note": "绑定行**保留**；不自动删除"
      },
      {
        "step": 3,
        "action": "此时创建新任务（任务权限不变，仍可创建）",
        "task_state": "not_in_roster",
        "snapshot_fields": "行值照存（含 runner/model 标识与 alias）",
        "note": "不报 bound；不猜默认模型"
      },
      {
        "step": 4,
        "action": "POST /sync 再次包含该成员（回册）",
        "get_binding_state": "bound",
        "row_exists": true,
        "note": "同一行自动恢复有效，无需重建绑定"
      },
      {
        "step": 5,
        "action": "回册后创建新任务",
        "task_state": "bound",
        "note": "步骤 3 的历史任务快照逐字节不变（not_in_roster 记录保留）"
      }
    ],
    "invariants": [
